{
  "name": "git-light",
  "version": "1.3.0",
  "description": "Free, open-source desktop Git client (Tauri 2, Vue 3, TypeScript, Rust) — graph-first alternative to GitKraken with commit graph, branches, staging and real local Git operations.",
  "author": "Git Light <ftuyama@users.noreply.github.com>",
  "license": "MIT",
  "productName": "Git Light",
  "repository": {
    "type": "git",
    "url": "https://github.com/ftuyama/git-light.git"
  },
  "main": "index.html",
  "engines": {
    "node": ">=20"
  },
  "resolutions": {
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:tauri": "vite --port 1420",
    "build:tauri": "vite build",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/app-icon.json",
    "dist:tauri": "tauri build",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run test && npm run sync-version -- --check && npm run rust:clippy && npm run rust:fmt:check",
    "build": "vite build",
    "site": "python3 -m http.server 4173 --directory docs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/build-site.mjs --check",
    "sync-version": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "wt:add": "node scripts/worktree.mjs add",
    "wt:ls": "node scripts/worktree.mjs list",
    "wt:rm": "node scripts/worktree.mjs remove",
    "wt:prune": "node scripts/worktree.mjs prune"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@lucide/vue": "^1.74.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/vue-virtual": "^3.13.52",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "motion-v": "^2.12.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "splitpanes": "^4.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "file-icons-js": "^1.1.0",
    "vue-i18n": "^11.4.21"
  }
}
