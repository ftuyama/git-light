{
  "name": "git-light",
  "version": "1.0.0",
  "description": "Free, open-source desktop Git client (Tauri 2, Vue 3, TypeScript, Rust) — graph-first alternative to GitKraken with commit graph, branches, staging and real local Git operations.",
  "author": "Git Light <ftuyama@users.noreply.github.com>",
  "license": "MIT",
  "productName": "Git Light",
  "repository": {
    "type": "git",
    "url": "https://github.com/ftuyama/git-light.git"
  },
  "main": "index.html",
  "engines": {
    "node": ">=20"
  },
  "resolutions": {
    "vite": "^7.3.6"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:tauri": "vite --port 1420",
    "build:tauri": "vite build",
    "tauri": "tauri",
    "dist:tauri": "tauri build",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rust:fmt": "cargo fmt",
    "rust:fmt:check": "cargo fmt --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run test && npm run sync-version -- --check && npm run rust:clippy && npm run rust:fmt:check",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "sync-version": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@lucide/vue": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.47",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "motion-v": "^2.8.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "splitpanes": "^4.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.9",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "file-icons-js": "^1.1.0"
  }
}
